<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="com.autochips.avm.viewmode.RearviewMirrorModel" />


        <variable
            name="passedText"
            type="String" />

    </data>

    <LinearLayout
        android:id="@+id/ll_rearviewMirror"
        binding:onClickCommand="@{viewModel.pRearviewClick}"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="126px"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_rearview"
            android:layout_width="wrap_content"
            android:layout_height="36px"
            android:layout_marginLeft="33px"
            android:layout_marginTop="42px"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/setting_rearview_mirror"
            android:textAlignment="center"
            android:textColor="@color/setting_view_content_color"
            android:textSize="@dimen/text_size_27px" />

        <LinearLayout
            android:id="@+id/ll_fold"
            android:layout_width="623dp"
            android:layout_height="126px"
            android:layout_marginLeft="30px"
            android:layout_marginTop="18px"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Switch
                android:id="@+id/sw_fold"
                style="@style/SwitchStyle"
                android:layout_gravity="center_vertical" />

            <TextView
                android:id="@+id/tv_flod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="18px"
                android:gravity="center_vertical"
                android:text="@string/setting_fold"
                android:textColor="@color/setting_view_content_color"
                android:textSize="@dimen/text_size_27px" />

        </LinearLayout>

        <View
            android:id="@+id/view_line"
            android:layout_width="match_parent"
            android:layout_height="2px"
            android:layout_marginStart="30px"
            android:layout_marginEnd="30px"
            />

        <LinearLayout
            android:id="@+id/ll_setting_rearview_mirror_down"
            android:layout_width="623dp"
            android:layout_height="126px"
            android:layout_marginLeft="30px"
            android:layout_marginTop="18px"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Switch
                android:id="@+id/sw_rearview_mirror_down"
                style="@style/SwitchStyle"
                android:layout_gravity="center_vertical" />

            <TextView
                android:id="@+id/tv_setting_rearview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="18px"
                android:gravity="center_vertical"
                android:text="@string/setting_rearview_mirror_down"
                android:textColor="@color/setting_view_content_color"
                android:textSize="@dimen/text_size_27px" />

        </LinearLayout>
    </LinearLayout>

</layout>