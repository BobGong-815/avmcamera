<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <item android:state_checked="true">
        <shape android:shape="oval">
            <size android:height="44px" android:width="44px"/>
            <solid android:color="@android:color/white"/>
            <stroke android:width="4px" android:color="@android:color/white"/>
        </shape>
    </item>
    <item android:state_checked="false">
        <shape android:shape="oval">
            <size android:height="44px" android:width="44px"/>
            <solid android:color="#919494"/>
            <stroke android:width="4px" android:color="#919494"/>
        </shape>
    </item>
</selector>
